{
  "name": "spaceship-defender",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @spaceship-defender/server --filter @spaceship-defender/display --filter @spaceship-defender/controller --filter @spaceship-defender/admin dev",
    "build": "pnpm -r build",
    "benchmark:combat": "pnpm --filter @spaceship-defender/server benchmark:combat",
    "demo:visible": "node scripts/run-visible-demo.mjs",
    "demo:verify": "cross-env DEMO_HEADLESS=1 DEMO_VERIFY=1 node scripts/run-visible-demo.mjs",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @spaceship-defender/server build && node scripts/run-e2e.mjs",
    "smoke:network": "pnpm --filter @spaceship-defender/server build && pnpm --filter @spaceship-defender/controller smoke:network",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm smoke:network && pnpm test:e2e",
    "spec": "cross-env OPENSPEC_TELEMETRY=0 openspec",
    "spec:status": "cross-env OPENSPEC_TELEMETRY=0 openspec status",
    "spec:validate": "cross-env OPENSPEC_TELEMETRY=0 openspec validate --all"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@fission-ai/openspec": "latest",
    "@playwright/test": "1.62.0",
    "@types/node": "26.1.1",
    "cross-env": "latest",
    "eslint": "latest",
    "prettier": "latest",
    "typescript": "6.0.2",
    "typescript-eslint": "latest",
    "vitest": "latest"
  }
}
