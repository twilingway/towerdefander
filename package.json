{
  "name": "spaceship-defender",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node scripts/run-dev.mjs",
    "build": "pnpm -r build",
    "benchmark:combat": "pnpm --filter @spaceship-defender/server benchmark:combat",
    "arena:match": "pnpm --filter @spaceship-defender/server arena:match",
    "stats:autopilot": "pnpm --filter @spaceship-defender/server stats:autopilot",
    "stats:batch": "pnpm --filter @spaceship-defender/server stats:batch",
    "stats:matrix": "pnpm stats:batch --levels rookie,veteran,ace --hulls guardian,blade,bastion --runs 20 --seed 1 --max-waves 30",
    "balance:promote": "pnpm --filter @spaceship-defender/server balance:promote",
    "campaign:author": "node apps/server/scripts/author-campaign.mjs",
    "campaign:preview": "node apps/server/scripts/author-campaign.mjs --dry-run",
    "fx:edit": "node scripts/run-fx-editor.mjs",
    "art:prepare": "node scripts/prepare-key-art.mjs",
    "fx:bake": "node scripts/bake-fx-atlases.mjs",
    "fx:editor": "node \"tools/arcadia-effects/Arcada Effects/server.mjs\"",
    "dev:bots": "cross-env ALLOW_BOT_CREW=true ALLOW_START_WAVE=true node scripts/run-dev.mjs",
    "watch:bots": "node scripts/watch-bot-crew.mjs",
    "demo:visible": "node scripts/run-visible-demo.mjs",
    "demo:verify": "cross-env DEMO_HEADLESS=1 DEMO_VERIFY=1 DEMO_BOT_LEVEL=rookie node scripts/run-visible-demo.mjs",
    "demo:guardian": "cross-env DEMO_SHIP=guardian node scripts/run-visible-demo.mjs",
    "demo:blade": "cross-env DEMO_SHIP=blade node scripts/run-visible-demo.mjs",
    "demo:bastion": "cross-env DEMO_SHIP=bastion node scripts/run-visible-demo.mjs",
    "daily:video": "node scripts/daily-video.mjs",
    "history:evidence": "node scripts/project-history-evidence.mjs",
    "history:capture": "node scripts/project-history-capture.mjs",
    "history:build": "node scripts/project-history-build.mjs",
    "history:dashboard": "node scripts/serve-project-history.mjs",
    "daily:dashboard": "node scripts/serve-daily-dashboard.mjs",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test && node --test scripts/bake-fx-atlases.node-test.mjs",
    "test:e2e": "pnpm --filter @spaceship-defender/server build && node scripts/run-e2e.mjs",
    "smoke:network": "pnpm --filter @spaceship-defender/server build && pnpm --filter @spaceship-defender/controller smoke:network",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm smoke:network && pnpm test:e2e",
    "check:ci": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm smoke:network",
    "spec": "cross-env OPENSPEC_TELEMETRY=0 openspec",
    "spec:status": "cross-env OPENSPEC_TELEMETRY=0 openspec status",
    "spec:validate": "cross-env OPENSPEC_TELEMETRY=0 openspec validate --all",
    "demo:boss": "cross-env DEMO_START_WAVE=5 node scripts/run-visible-demo.mjs"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@fission-ai/openspec": "latest",
    "@playwright/test": "1.62.0",
    "@types/node": "26.1.1",
    "cross-env": "latest",
    "eslint": "latest",
    "prettier": "latest",
    "typescript": "6.0.2",
    "typescript-eslint": "latest",
    "vitest": "latest"
  }
}
