{
  "name": "@spaceship-defender/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "benchmark:combat": "pnpm run build && node dist/benchmarks/runCombatRoomBenchmark.js",
    "stats:autopilot": "node scripts/run-autopilot-stats.mjs",
    "stats:batch": "node scripts/run-balance-batch.mjs",
    "dev": "node --env-file-if-exists=../../.env.local --import tsx --watch src/index.ts",
    "start": "node --env-file-if-exists=../../.env.local dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests && node --test scripts/autopilot-stats.node-test.mjs"
  },
  "dependencies": {
    "@colyseus/auth": "0.18.2",
    "@colyseus/redis-driver": "0.18.2",
    "@colyseus/redis-presence": "0.18.3",
    "@colyseus/schema": "5.0.27",
    "@colyseus/uwebsockets-transport": "0.18.2",
    "@colyseus/ws-transport": "0.18.2",
    "@spaceship-defender/game-core": "workspace:*",
    "@spaceship-defender/protocol": "workspace:*",
    "colyseus": "0.18.5"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.1.1",
    "tsup": "8.5.1",
    "tsx": "4.23.1",
    "typescript": "6.0.2",
    "vitest": "4.1.10"
  }
}
