# Public WebSocket endpoint used by display and controller clients.
VITE_GAME_SERVER_URL=ws://localhost:2567

# Public controller URL embedded into the display QR code.
VITE_CONTROLLER_URL=http://localhost:5174

# Colyseus HTTP/WebSocket port.
HOST=0.0.0.0
PORT=2567
RECONNECTION_GRACE_SECONDS=30

# Automatic room disposal deadlines in seconds.
ROOM_LOBBY_TTL_SECONDS=900
ROOM_RESULT_TTL_SECONDS=600
ROOM_ZERO_CONTROLLER_TTL_SECONDS=300
ROOM_WAVE_TTL_SECONDS=300
ROOM_ABSOLUTE_TTL_SECONDS=43200

# Rooms one process hosts at once. Every room shares the same event loop, so a
# process past its ceiling slows every room it already runs, not just the new
# one. Measured ceiling on a Ryzen 9 5900X is about 40 rooms on late waves.
ROOM_MAX_CONCURRENT=30

# Optional remote access password for /stats/rooms (Basic user: admin).
# Without it, statistics are available only from localhost.
# Required in a public deployment: behind a reverse proxy the server sees the
# proxy's address, so the loopback allowance never applies and an unset password
# refuses every request instead of trusting one. See docs/DEPLOYMENT.md.
# ROOM_STATS_PASSWORD=replace-with-a-secret

# Balance presets edited by the admin console, applied to the next run.
# Defaults to apps/server/data/balance.json, resolved against the server package
# so `pnpm dev` and the demo harnesses share one file. Set it to override.
# BALANCE_PRESET_PATH=./data/balance.json

# Balance-statistics batches: where the console keeps finished reports, how many
# survive rotation, and the wall-clock ceiling on one batch. A batch is CPU-bound
# and shares the machine with live rooms, so the ceiling is what stops a mistyped
# matrix from holding a core. Defaults: apps/server/data/stats-batches, 50, 1800.
# STATS_BATCH_DIR=./data/stats-batches
# STATS_BATCH_KEEP=50
# STATS_BATCH_TIMEOUT_SECONDS=1800

# Lets a display ask a room to open on a late wave, so a boss can be tested
# without clearing the waves before it. Off unless set to true, because a public
# server should not accept it. With it on, the display shows a wave field beside
# the crew size, and `?wave=5` in the address fills that field in.
# ALLOW_START_WAVE=true

# Optional remote access password for /admin/balance (Basic user: admin).
# Without it, the balance API is available only from localhost.
# Required in a public deployment, for the same reason as ROOM_STATS_PASSWORD
# above: the console reaches the API through nginx, not over loopback.
# ADMIN_BALANCE_PASSWORD=replace-with-a-secret
