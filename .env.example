# Public WebSocket endpoint used by display and controller clients.
VITE_GAME_SERVER_URL=ws://localhost:2567

# Public controller URL embedded into the display QR code.
VITE_CONTROLLER_URL=http://localhost:5174

# Colyseus HTTP/WebSocket port.
HOST=0.0.0.0
PORT=2567
RECONNECTION_GRACE_SECONDS=30

# Automatic room disposal deadlines in seconds.
ROOM_LOBBY_TTL_SECONDS=900
ROOM_RESULT_TTL_SECONDS=600
ROOM_ZERO_CONTROLLER_TTL_SECONDS=300
ROOM_WAVE_TTL_SECONDS=1200
ROOM_ABSOLUTE_TTL_SECONDS=43200

# Optional remote access password for /stats/rooms (Basic user: admin).
# Without it, statistics are available only from localhost.
# ROOM_STATS_PASSWORD=replace-with-a-secret

# Balance presets edited by the admin console, applied to the next run.
BALANCE_PRESET_PATH=./data/balance.json

# Optional remote access password for /admin/balance (Basic user: admin).
# Without it, the balance API is available only from localhost.
# ADMIN_BALANCE_PASSWORD=replace-with-a-secret
