# Production environment for docker-compose.prod.yml.
#
# Copy this outside the repository -- the deploy script expects it at
# $SPACE_PROD_DIR/.env.production -- fill in real values and `chmod 600` it.
# Never commit the filled-in file: it holds the passwords and the public
# endpoints, and both are out of bounds for this repository.

# Public addresses baked into the browser builds. The API is the WebSocket
# scheme, because that is what the Colyseus client is handed; the display
# derives the https origin from it for the public hull catalogue.
PUBLIC_API_URL=wss://api.example.test
PUBLIC_CONTROLLER_URL=https://control.example.test
# Only the release smoke check reads this one; nothing is built from it.
PUBLIC_DISPLAY_URL=https://display.example.test

# Basic auth for /admin/* and /stats/* (user: admin). Required, not optional:
# behind the reverse proxy the server sees the proxy's address, so its "allowed
# from localhost" fallback never applies. Generate with
# `openssl rand -base64 24`.
ADMIN_BALANCE_PASSWORD=replace-me
ROOM_STATS_PASSWORD=replace-me

# Rooms one process hosts at once. The packaged default of 30 was measured on a
# 12-thread desktop; every room shares one event loop, so this belongs at what
# the host can actually give the 20 Hz tick.
ROOM_MAX_CONCURRENT=8

# Where the console answers on the local network.
ADMIN_HTTP_PORT=8081
# Loopback port for the release script's health check and room smoke test.
API_LOCAL_PORT=2567

# The reverse proxy's existing external Docker network.
PROXY_NETWORK=public_net

# How long a release waits for live rooms to close before restarting anyway.
DEPLOY_DRAIN_MINUTES=10

# Branch the deploy agent follows, and the repository it asks about check
# status. Both public information; no token is needed for a public repository.
DEPLOY_BRANCH=main
DEPLOY_REPO=owner/repository
